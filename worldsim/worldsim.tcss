Screen {
    background: #0f1117;
    color: #e5e7eb;
}

#root {
    height: 100%;
    layout: vertical;
}

#switcher {
    width: 100%;
    height: 1fr;
}

#landing-screen,
#setup-screen {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#landing-card,
#setup-card {
    width: 100%;
    height: 100%;
    border: round #8b5cf6;
    background: #171a22;
    padding: 1 2;
    align: center middle;
}

#landing-title,
#setup-title {
    width: 100%;
    color: #f8fafc;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

#save-summary,
#setup-subtitle {
    width: 100%;
    color: #a5b4fc;
    margin-bottom: 1;
    text-align: center;
}

#landing-actions,
#setup-actions {
    height: auto;
    margin-top: 1;
    align: center middle;
}

#setup-error {
    width: 100%;
}

#setup-inputs {
    width: 100%;
    height: auto;
    align: center middle;
}

#name-input,
#theme-input {
    width: 70%;
}

#setup-error {
    color: #fca5a5;
    margin-top: 1;
    height: auto;
    max-height: 5;
    overflow: auto auto;
    text-align: center;
}

#character-select {
    display: none;
    width: 90%;
    height: 1fr;
    margin-top: 1;
}

#selection-grid {
    height: 100%;
}

#class-options-panel {
    width: 24%;
    height: 100%;
    border: round #334155;
    padding: 0 1;
    margin-right: 1;
}

#homeland-options-panel {
    width: 24%;
    height: 100%;
    border: round #334155;
    padding: 0 1;
    margin-right: 1;
}

#class-detail-panel {
    width: 1fr;
    height: 100%;
    border: round #8b5cf6;
    padding: 0 1;
    overflow: hidden auto;
    color: #dbeafe;
}

#class-options-title,
#homeland-options-title {
    color: #f8d774;
    text-style: bold;
    height: 1;
}

#game-screen {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 3;
    background: #171a22;
    color: #f8fafc;
    padding: 1 2;
    text-style: bold;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: #11151d;
    color: #94a3b8;
}

Tabs Tab {
    padding: 0 2;
}

Tabs Tab.-active {
    background: #1e293b;
    color: #f8d774;
    text-style: bold;
}

TabPane {
    padding: 1;
}

.row {
    height: 1fr;
}

.stack {
    width: 28%;
    height: 100%;
}

.world-sidebar {
    width: 22%;
    height: 100%;
}

.play-sidebar {
    width: 30%;
    height: 100%;
}

.panel {
    border: round #374151;
    background: #151821;
    color: #e5e7eb;
    padding: 0 1;
    margin-bottom: 1;
    overflow: hidden auto;
}

#map-panel {
    width: 1fr;
    height: 100%;
    border: round #3b82f6;
    background: #0b1220;
    overflow: auto auto;
}

#region-panel {
    height: 30%;
}

#events-panel {
    height: 34%;
}

#alerts-panel {
    height: 16%;
    border: round #ef4444;
}

#summary-panel {
    height: 20%;
}

#player-panel,
#hooks-panel,
#local-panel,
#system-panel {
    height: 1fr;
}

#actions-panel {
    height: 20;
    overflow: hidden auto;
}

#director-panel {
    height: 8;
    border: round #a855f7;
    background: #161120;
    color: #f8fafc;
    padding: 0 1;
    overflow: hidden auto;
}

#adventure-command-bar {
    height: 3;
    align: center middle;
}

#adventure-prompt {
    width: 3;
    color: #f8d774;
    text-style: bold;
}

#adventure-command-input {
    width: 1fr;
}

#console-panel {
    height: 8;
    border: round #22c55e;
    background: #101713;
    color: #e5e7eb;
    padding: 0 1;
    overflow: hidden auto;
}

#command-bar {
    height: 3;
    background: #171a22;
    padding: 0 1;
    align: center middle;
}

#prompt {
    width: 12;
    color: #f8d774;
    text-style: bold;
}

#command-input {
    width: 1fr;
}

#footer-note {
    height: 1;
    color: #94a3b8;
    padding: 0 1;
}
